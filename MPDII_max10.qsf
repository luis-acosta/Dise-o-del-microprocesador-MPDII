#==============================================================================
# Proyecto : MPDII - Microprocesador didactico de 8 bits
# Archivo  : MPDII.qsf  para MAX 10  (10M08DAF484C8G - tarjeta DE10-Lite)
#==============================================================================
# Reemplaza el MPDII.qsf anterior, que apuntaba a Cyclone II.
# Cierra Quartus, sustituye el archivo, y vuelve a abrir MPDII.qpf.
#==============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08DAF484C8G
set_global_assignment -name TOP_LEVEL_ENTITY MPDII
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 19.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "19.1.0 Lite Edition"

set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 484
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8

#------------------------------------------------------------------------------
# Archivos fuente   (SOLO sintesis: el banco de pruebas NO va aqui)
#------------------------------------------------------------------------------
set_global_assignment -name VHDL_FILE rtl/mux2to1_8.vhd
set_global_assignment -name VHDL_FILE rtl/mux4to1_8.vhd
set_global_assignment -name VHDL_FILE rtl/inc8.vhd
set_global_assignment -name VHDL_FILE rtl/alu8.vhd
set_global_assignment -name VHDL_FILE rtl/shifter8.vhd
set_global_assignment -name VHDL_FILE rtl/tristate8.vhd
set_global_assignment -name VHDL_FILE rtl/flags.vhd
set_global_assignment -name VHDL_FILE rtl/rom256x13.vhd
set_global_assignment -name VHDL_FILE rtl/reg8.vhd
set_global_assignment -name VHDL_FILE rtl/reg13.vhd
set_global_assignment -name VHDL_FILE rtl/regfile16x8.vhd
set_global_assignment -name VHDL_FILE rtl/datapath.vhd
set_global_assignment -name VHDL_FILE rtl/control_unit.vhd
set_global_assignment -name VHDL_FILE rtl/MPDII.vhd

#------------------------------------------------------------------------------
# Simulacion con ModelSim (el testbench va SOLO en esta seccion)
#------------------------------------------------------------------------------
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ns" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_MPDII -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_MPDII -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_MPDII
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_MPDII -section_id tb_MPDII
set_global_assignment -name EDA_TEST_BENCH_FILE sim/tb_MPDII.vhd -section_id tb_MPDII
set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "6 us" -section_id tb_MPDII

#------------------------------------------------------------------------------
# Pines sin asignar: deja que el Fitter los coloque solo.
# Asi la compilacion llega hasta el final y puedes ver el reporte de recursos
# y de tiempos. Para montar en la tarjeta, descomenta la seccion de abajo.
#------------------------------------------------------------------------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"

#------------------------------------------------------------------------------
# ASIGNACION DE PINES PARA DE10-Lite  -  VERIFICAR CONTRA EL MANUAL DE TU TARJETA
#
#   OJO con el reset: en la DE10-Lite los pulsadores KEY son ACTIVOS EN BAJO
#   (valen '1' en reposo y '0' al presionarlos).  El puerto reset del MPDII es
#   activo en alto, asi que conectarlo directo a KEY0 deja el procesador
#   permanentemente en reset.  Hay dos salidas:
#     a) usar un interruptor SW en lugar de un KEY, o
#     b) envolver el TOP en un nivel que haga  reset <= not KEY(0);
#
# set_location_assignment PIN_P11 -to clk          ;# MAX10_CLK1_50
# set_location_assignment PIN_C10 -to reset        ;# SW0  (activo en alto)
#
# set_location_assignment PIN_C11 -to Input_dp[0]  ;# SW1
# set_location_assignment PIN_D12 -to Input_dp[1]  ;# SW2
# set_location_assignment PIN_C12 -to Input_dp[2]  ;# SW3
# set_location_assignment PIN_A12 -to Input_dp[3]  ;# SW4
# set_location_assignment PIN_B12 -to Input_dp[4]  ;# SW5
# set_location_assignment PIN_A13 -to Input_dp[5]  ;# SW6
# set_location_assignment PIN_A14 -to Input_dp[6]  ;# SW7
# set_location_assignment PIN_B14 -to Input_dp[7]  ;# SW8
#
# set_location_assignment PIN_A8  -to OUT_dp[0]    ;# LEDR0
# set_location_assignment PIN_A9  -to OUT_dp[1]    ;# LEDR1
# set_location_assignment PIN_A10 -to OUT_dp[2]    ;# LEDR2
# set_location_assignment PIN_B10 -to OUT_dp[3]    ;# LEDR3
# set_location_assignment PIN_D13 -to OUT_dp[4]    ;# LEDR4
# set_location_assignment PIN_C13 -to OUT_dp[5]    ;# LEDR5
# set_location_assignment PIN_E14 -to OUT_dp[6]    ;# LEDR6
# set_location_assignment PIN_D14 -to OUT_dp[7]    ;# LEDR7
#
# set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
# set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
# set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Input_dp
# set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to OUT_dp
#------------------------------------------------------------------------------
